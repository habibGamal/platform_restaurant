APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ar
APP_TIMEZONE=Africa/Cairo
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Assistant jobs run on their own "assistant" connection/queue; its retry_after must exceed the
# assistant run timeout (900 s). Worker: php artisan queue:work assistant --queue=assistant --timeout=900 --tries=1
ASSISTANT_QUEUE_RETRY_AFTER=960
# When true, visits to the Filament assistant page redirect to the React chat UI.
ASSISTANT_REACT_UI=true

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

OPENAI_COMPATIBLE_URL=
OPENAI_COMPATIBLE_API_KEY=

# "openai" (Responses API, api.openai.com — the default) or "openai-compatible" (Chat Completions, for proxies).
# Example for an OpenAI-compatible proxy:
# OPENAI_DRIVER=openai-compatible
# OPENAI_URL=https://api.miraiapi.com/v1
OPENAI_DRIVER=openai
OPENAI_URL=https://api.openai.com/v1

# Anthropic (Claude). For Cloudflare AI, point the URL at your account and send the token as Bearer;
# model names then take Cloudflare's form, e.g. anthropic/claude-sonnet-5.5.
ANTHROPIC_API_KEY=
ANTHROPIC_URL=https://api.anthropic.com/v1
# ANTHROPIC_URL=https://api.cloudflare.com/client/v4/accounts/<account_id>/ai/v1
ANTHROPIC_BEARER_AUTH=false

# Cloudflare Workers AI (provider "cloudflare"): Cloudflare-hosted @cf/ models, billed in Workers AI Neurons.
# The token needs Account > Workers AI > Read.
CLOUDFLARE_AI_URL=https://api.cloudflare.com/client/v4/accounts/<account_id>/ai/v1
CLOUDFLARE_AI_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/google/gemma-4-26b-a4b-it

# Local restaurant MCP server (php artisan mcp:start restaurants): the user id its tools act as.
MCP_USER_ID=
# Remote MCP server (/mcp/restaurants, OAuth): redirect origins clients may register (comma-separated).
# MCP_REDIRECT_DOMAINS=https://claude.ai,https://claude.com,https://chatgpt.com,https://chat.openai.com,http://localhost,http://127.0.0.1
# Proxies whose X-Forwarded-* headers are trusted, e.g. "*" behind Cloudflare Tunnel. Empty = none.
TRUSTED_PROXIES=

VITE_APP_NAME="${APP_NAME}"
